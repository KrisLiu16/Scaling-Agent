# Copy to deploy/coord.env. With admin credentials set, the coordination server bootstraps Gitea itself
# (org, repo, merge-bot + token, branch protection, webhook) and keeps the bot token/secret in its DB.
SA_COORD_GITEA__ADMIN_USER=root
SA_COORD_GITEA__ADMIN_PASSWORD=
SA_COORD_GITEA__OWNER=agents
SA_COORD_GITEA__REPO=workspace
SA_COORD_GITEA__MAIN_BRANCH=main
SA_COORD_GITEA__BOT_USER=merge-bot
# Board delivery: "relevant" (scope-filtered, default) or "all" (Agensh behaviour, for ablations).
SA_COORD_BOARD_MODE=relevant
# Optional: verify the merged result before landing (runs in a temp checkout on this host).
# SA_COORD_VERIFY_COMMAND=bash compile.sh && ./run_tests.sh
